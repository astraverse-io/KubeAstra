# ── Kubernetes / kubectl ──────────────────────────────────────────────────────
# Comma-separated list of namespaces the server is allowed to query
ALLOWED_NAMESPACES=demo,prod,staging,dev,default

# Path to kubeconfig (defaults to ~/.kube/config)
# KUBECONFIG_PATH=/home/user/.kube/config

# kubectl command timeout in seconds
KUBECTL_TIMEOUT_SECONDS=15

# Max log lines to return per request
MAX_LOG_TAIL_LINES=200

# Max bytes of output per tool response
MAX_OUTPUT_BYTES=20000

# Enable k8sgpt CLI integration (requires k8sgpt installed)
ENABLE_K8SGPT=false

# Enable write/recovery operations (delete_pod, rollout_restart, scale_deployment, apply_patch, exec_pod_command)
ENABLE_RECOVERY_OPERATIONS=false

# Max replicas allowed when scaling
MAX_SCALE_REPLICAS=100

# ── Deployment Repository ─────────────────────────────────────────────────────
DEPLOYMENT_REPO_URL=git@github.com:your-org/deployment-provisioning.git
# GITHUB_TOKEN=ghp_your_token_here  # for HTTPS private repos

# ── LLM provider ──────────────────────────────────────────────────────────────
# gemini is the default; set ollama for a local or remote self-hosted model.
LLM_PROVIDER=gemini

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
# Backwards-compatible single-model catalog for older clients.
GEMINI_AVAILABLE_MODELS=gemini-3.1-flash-lite

# ── Ollama (optional) ─────────────────────────────────────────────────────────
# Local default:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Fallback list for the chat model dropdown when /api/tags is unavailable.
OLLAMA_AVAILABLE_MODELS=llama3.1
# Optional when Ollama sits behind a reverse proxy or API gateway:
# OLLAMA_AUTH_TOKEN=replace_me
# Increase for larger remote models if needed:
OLLAMA_TIMEOUT_SECONDS=120

# ── Vector DB / RAG (optional — run: make docker-up to start Qdrant) ─────────
# Phase 1.1 replaced Weaviate with Qdrant. WEAVIATE_* env vars are ignored.
QDRANT_URL=http://localhost:6333
# Leave empty for dev; set in production via Helm (qdrant.auth.apiKey).
QDRANT_API_KEY=
QDRANT_COLLECTION=k8s_errors
QDRANT_TIMEOUT_SECONDS=10

# ── Embeddings (local, no API key needed) ─────────────────────────────────────
# EMBEDDING_DIM must match the model's native dimension (MiniLM-L6 = 384).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── HTTP MCP transport (optional) ─────────────────────────────────────────────
# Local Streamable HTTP endpoint for remote IDE / MCP testing
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8001
MCP_HTTP_PATH=/mcp

# Optional bearer token for HTTP MCP clients
# MCP_HTTP_AUTH_TOKEN=dev-local-token
