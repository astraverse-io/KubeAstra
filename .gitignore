# ── Archive (internal docs, not part of OSS repo) ─────────────────────────────
archive/
internal_docs
# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Environment / secrets ──────────────────────────────────────────────────────
# Never commit real secrets. Copy .env.example → .env and fill in your values.
.env
.env.local
.env.*.local
ui/backend/.demo-kubeconfig
ui/.env.demo
ui/.env.kubeastra-demo.bak

# ── Runtime files ──────────────────────────────────────────────────────────────
*.log
audit.log

# ── SQLite session data ────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal

# ── Node.js / Next.js ─────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
# Transient during `npm run build:desktop` (restored on exit; present only if a build was killed)
.desktop-build-stash/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Test / lint caches ─────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
scripts/demo-recorder/output/
helm/kubeastra/values-dev.yaml

# ── Helm secrets ──────────────────────────────────────────────────────────────
# Never commit values-secrets.yaml — it contains real API keys / tokens.
helm/**/values-secrets.yaml
values-secrets.yaml

# ── Virtual envs (any variant) ────────────────────────────────────────────────
.venv-eval/
.venv-*/
venv-*/

# Rust build output (Tauri spike / desktop shell)
target/

# Desktop packaging output
desktop/build/
desktop/src-tauri/binaries/
desktop/src-tauri/gen/schemas/

# ── Generated knowledge graphs (graphify) ─────────────────────────────────────
# Regenerated from the source it describes, so it is derived data, not source.
# Worth ignoring rather than merely not committing: a single run drops ~10 MB
# here (graph.json plus a self-contained graph.html), and the tool writes one
# of these next to whichever directory it was pointed at — so `git add -A` from
# the repo root would sweep up several copies at once.
graphify-out/
