# Path to mcp project (only needed when running outside Docker)
MCP_PATH=../../mcp

# ── LLM provider ──────────────────────────────────────────────────────────────
# Supported: gemini (default), ollama (local), anthropic, openai.
LLM_PROVIDER=gemini

# ── AI / Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_AVAILABLE_MODELS=gemini-3.1-flash-lite

# Enable multi-step ReAct investigations. Disabled by default to reduce LLM RPM usage.
USE_REACT_CHAT=false

# ── Ollama (optional) ─────────────────────────────────────────────────────────
# Local default:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_AVAILABLE_MODELS=llama3.1
# Optional when Ollama sits behind a reverse proxy or API gateway:
# OLLAMA_AUTH_TOKEN=replace_me
OLLAMA_TIMEOUT_SECONDS=120

# ── Anthropic Claude (optional) ───────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_TIMEOUT_SECONDS=120

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=openai. OPENAI_BASE_URL lets you point at any
# OpenAI-compatible endpoint (Azure OpenAI, vLLM, LiteLLM, ...).
# OPENAI_API_KEY=sk-your_key_here
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_SECONDS=120

# ── Kubernetes ────────────────────────────────────────────────────────────────
ALLOWED_NAMESPACES=demo,prod,staging,dev,default
KUBECTL_TIMEOUT_SECONDS=15
MAX_LOG_TAIL_LINES=200
MAX_OUTPUT_BYTES=20000
ENABLE_RECOVERY_OPERATIONS=false

# ── Vector DB / RAG (optional) — Qdrant since Phase 1.1 ──────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=k8s_errors
QDRANT_TIMEOUT_SECONDS=10
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Hugging Face / sentence-transformers local runtime ────────────────────────
# Keep embedding model cache inside the local backend folder and suppress noisy
# startup progress/report logs. HF_TOKEN is optional for higher Hub rate limits.
HF_HOME=.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=.cache/huggingface
HF_HUB_DISABLE_PROGRESS_BARS=1
HF_HUB_VERBOSITY=error
TRANSFORMERS_VERBOSITY=error
TOKENIZERS_PARALLELISM=false
# HF_TOKEN=
