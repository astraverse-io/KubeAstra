{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@frontend/*": ["../../../ui/frontend/*"],
      "@components/*": ["../../../ui/frontend/components/*"],
      "@lib/*": ["../../../ui/frontend/lib/*"]
    }
  },
  "include": ["src"]
}
