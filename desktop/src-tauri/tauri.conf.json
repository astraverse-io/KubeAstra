{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KubeAstra",
  "version": "0.2.0",
  "identifier": "io.astraverse.kubeastra",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "title": "KubeAstra",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/kubeastra-backend/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "kubeastra"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFOTNFN0E0OUE4OUQwRkQKUldUOTBJbWFwT2VUcnJEejFlZFpRM0xnRXhRKzByWGRhTkpZSHU0Y2NWQm1Qb3U4ajFXRk4wV0wK",
      "endpoints": [
        "https://github.com/astraverse-io/KubeAstra/releases/latest/download/latest.json"
      ]
    }
  }
}
